# AWS Builder mini-challenge — Amazon Bedrock (HALTED customer explanations)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ALGUARD_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0


# Security: both tiers FAIL CLOSED by default. Without OAuth configured, the
# servers refuse to start / serve unless you explicitly opt into local dev:
# ALGUARD_DEV_MODE=1
# ALGUARD_DEV_USER=UNVERIFIED_DEV_AGENT   # Tier 2 local demo identity

# Optional: relocate the Tier 1 actions ledger (default data/actions_log.db).
# ALGUARD_DB_PATH=/path/to/actions_log.db

# Internal ledger API (Tier 2 -> ledger, port 8015). Shared secret so only Tier 2 can
# read pending actions / resolve them. Leave unset for loopback-only local dev.
# ALGUARD_LEDGER_API_TOKEN=change-me

# Demo UI backend (port 8020) refuses to start unless explicitly enabled.
# ALGUARD_DEMO_UI=1

# Per-owner rate limit on attempt_purchase (requests/min; 0 disables). Default 120.
# ALGUARD_RATE_LIMIT_PER_MIN=120

# Optional retention for the actions ledger, in days (0 = keep forever).
# ALGUARD_RETENTION_DAYS=90

# Optional allowlist of authorized OAuth client_ids / azp (space/comma separated).
# If set, tokens whose authorized party is not listed are rejected.
# OAUTH_ALLOWED_CLIENTS=